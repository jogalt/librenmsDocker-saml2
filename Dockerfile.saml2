# syntax=docker/dockerfile:1

# LibreNMS + SocialiteProviders SAML2
#
# This file is intentionally separate from upstream's Dockerfile so the fork can
# merge librenms/docker:master without carrying changes to upstream-owned files.
ARG LIBRENMS_BASE_IMAGE="librenms/librenms:latest"

FROM ${LIBRENMS_BASE_IMAGE}

LABEL org.opencontainers.image.title="LibreNMS with SAML2" \
      org.opencontainers.image.description="LibreNMS with SocialiteProviders SAML2 support" \
      org.opencontainers.image.source="https://github.com/jogalt/librenmsDocker-saml2" \
      org.opencontainers.image.url="https://github.com/jogalt/librenmsDocker-saml2"

USER root
WORKDIR /opt/librenms

# Preserve the behavior recovered from the April 2026 image.
RUN set -eux; \
    su librenms -s /bin/sh -c \
      'COMPOSER_CACHE_DIR=/tmp composer require "socialiteproviders/saml2:^4.8" --no-interaction --no-ansi --no-scripts --no-progress'; \
    su librenms -s /bin/sh -c \
      'COMPOSER_CACHE_DIR=/tmp composer dump-autoload -o --no-interaction --no-ansi'; \
    su librenms -s /bin/sh -c \
      'composer show socialiteproviders/saml2'; \
    rm -rf /tmp/*

# ENTRYPOINT, VOLUME, EXPOSE, environment, and s6 configuration are inherited
# from librenms/librenms:latest.
